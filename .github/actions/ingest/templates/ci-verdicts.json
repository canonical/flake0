{
  "index_patterns": [
    "ci-verdicts"
  ],
  "template": {
    "settings": {
      "number_of_replicas": 0,
      "codec": "zstd",
      "index.mapping.ignore_malformed": true
    },
    "mappings": {
      "dynamic": false,
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "bundle_id": {
          "type": "keyword"
        },
        "tag": {
          "properties": {
            "run_id": {
              "type": "keyword"
            },
            "run_attempt": {
              "type": "keyword"
            },
            "repo": {
              "type": "keyword"
            },
            "workflow": {
              "type": "keyword"
            },
            "job": {
              "type": "keyword"
            },
            "sha": {
              "type": "keyword"
            },
            "ref": {
              "type": "keyword"
            },
            "runner_name": {
              "type": "keyword"
            },
            "runner_os": {
              "type": "keyword"
            },
            "image_os": {
              "type": "keyword"
            },
            "arch": {
              "type": "keyword"
            },
            "job_name": {
              "type": "keyword"
            }
          }
        },
        "model": {
          "type": "keyword"
        },
        "verdict": {
          "type": "keyword"
        },
        "root_cause": {
          "type": "keyword"
        },
        "recommendation": {
          "type": "keyword"
        },
        "confidence_pct": {
          "type": "integer"
        },
        "confidence_bucket": {
          "type": "keyword"
        },
        "failed_tests": {
          "type": "keyword"
        },
        "summary": {
          "type": "text"
        },
        "suggested_fix": {
          "type": "text"
        },
        "error_excerpt": {
          "type": "text"
        },
        "reasoning": {
          "type": "text"
        },
        "evidence": {
          "type": "text"
        },
        "error": {
          "type": "text"
        }
      }
    }
  }
}
