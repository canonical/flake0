        },
        "tag": {
          "properties": {
            "run_id": {
              "type": "keyword"
            },
            "run_attempt": {
              "type": "keyword"
            },
            "repo": {
              "type": "keyword"
            },
            "workflow": {
              "type": "keyword"
            },
            "job": {
              "type": "keyword"
            },
            "sha": {
              "type": "keyword"
            },
            "ref": {
              "type": "keyword"
            },
            "runner_name": {
              "type": "keyword"
            },
            "runner_os": {
              "type": "keyword"
            },
            "image_os": {
              "type": "keyword"
            },
            "arch": {
              "type": "keyword"
            },
            "job_name": {
              "type": "keyword"
            }
          }
        },
        "file": {
