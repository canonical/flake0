#!/usr/bin/env python3
"""Fake lxc CLI for tests/test_workload_watch.py.

Only `lxc exec [--project <p>] <name> -- journalctl ...` is supported. It prints
$FAKE_LXC_DIR/<p>_<name>/journal (or <name>/journal without a project) and then
blocks, like journalctl -f. A missing file makes it fail. Every invocation is
appended to $FAKE_LXC_DIR/calls.log.
"""

import os
import pathlib
import sys
import time

root = pathlib.Path(os.environ["FAKE_LXC_DIR"])
args = sys.argv[1:]
with open(root / "calls.log", "a") as calls:
    calls.write(" ".join(args) + "\n")

if args[:1] != ["exec"] or "--" not in args:
    print(f"Error: fake lxc: unsupported command {args}", file=sys.stderr)
    sys.exit(2)
head = args[1 : args.index("--")]
project = head[head.index("--project") + 1] if "--project" in head else ""
name = head[-1]
journal = root / (f"{project}_{name}" if project else name) / "journal"
if not journal.is_file():
    print(f"Error: fake lxc: no {journal.relative_to(root)}", file=sys.stderr)
    sys.exit(1)
sys.stdout.write(journal.read_text())
sys.stdout.flush()
while True:
    time.sleep(3600)
